  "info": {
    "description": "Predict problems before they happen.",
    "title": "ShopSense API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/forecast/category": {
      "get": {
        "description": "Forecast a top-10 category's items for the week ending on a Sunday.",
        "operationId": "forecast_category_forecast_category_get",
        "parameters": [
          {
            "in": "query",
            "name": "week_end",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Week End",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "category",
            "required": true,
            "schema": {
              "title": "Category",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryForecast"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forecast Category",
        "tags": [
          "Forecasts"
        ]
      }
    },
    "/forecast/options": {
      "get": {
        "description": "Return the forecastable date range and categories.",
        "operationId": "forecast_options_forecast_options_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastOptions"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Forecast Options",
        "tags": [
          "Forecasts"
        ]
      }
    },
    "/forecast/orders": {
      "get": {
        "description": "Forecast daily orders with a simple rule.",
        "operationId": "forecast_orders_forecast_orders_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Start",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 28,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/DailyForecast"
                  },
                  "title": "Response Forecast Orders Forecast Orders Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Forecast Orders",
        "tags": [
          "Forecasts"
        ]
      }
    },
    "/health": {
      "get": {
        "description": "Report what's loaded. The held model is expected to be unavailable.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "System"
        ]
      }
    },
    "/models": {
      "get": {
        "description": "List every package with its status and holdout verdict.",
        "operationId": "models_models_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ModelInfo"
                  },
                  "title": "Response Models Models Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Models",
        "tags": [
          "System"
        ]
      }
    },
    "/predict/delivery-time": {
      "post": {
        "description": "Estimate delivery days from a simple rule, the median by customer state.",
        "operationId": "predict_delivery_time_predict_delivery_time_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict Delivery Time",
        "tags": [
          "Predictions"
        ]
      }
    },
    "/predict/freight": {
      "post": {
        "description": "Estimate the freight for one product on a route.",
        "operationId": "predict_freight_predict_freight_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FreightRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FreightResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predict Freight",
        "tags": [
          "Predictions"
        ]
      }
    },
    "/predict/late-delivery": {
      "post": {
        "description": "Always returns 503, because this model failed its holdout test.",
        "operationId": "predict_late_delivery_predict_late_delivery_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Predict Late Delivery",
        "tags": [
          "Predictions"
        ]
      }
    },
    "/reviews/queue": {
      "get": {
        "description": "Rank recent orders by low-review risk, for support to contact first.",
        "operationId": "review_queue_reviews_queue_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewQueue"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Review Queue",
        "tags": [
          "Queues"
        ]
      }
    },
    "/sellers/at-risk": {
      "get": {
        "description": "List sellers likely to stop selling. Check revenue and recency too.",
        "operationId": "sellers_at_risk_sellers_at_risk_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "alerts_only",
            "required": false,
            "schema": {
              "default": true,
              "title": "Alerts Only",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SellerRiskList"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Sellers At Risk",
        "tags": [
          "Queues"
        ]
      }
    }
  }
